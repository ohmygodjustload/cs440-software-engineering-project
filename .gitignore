# =============================================================================
# .gitignore
# Combined for: C#/.NET (Visual Studio, Rider), Node.js/Angular, OS files, IDEs
# =============================================================================

# -----------------------------------------------------------------------------
# .NET / Visual Studio
# -----------------------------------------------------------------------------

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio cache/options directory
.vs/

# ASP.NET Scaffolding
ScaffoldingReadMe.txt

# Visual Studio build outputs and intermediate files
*_i.c
*_p.c
*_h.h
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pdb
*.ipdb
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# Visual Studio profiler
*.psess
*.vsp
*.vspx
*.sap

# TFS local workspace
$tf/

# Guidance Automation Toolkit
*.gpState

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Microsoft Azure Build Output
csx/
*.build.csdef

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# User-specific files (MonoDevelop/Xamarin Studio)
*.pidb
*.booproj
*.svd

# Coverage reports
*.coverage
*.coveragexml
coverage/
TestResults/
[Cc]overage*/

# JetBrains Rider
.idea/
*.sln.iml

# -----------------------------------------------------------------------------
# Node.js / Angular
# -----------------------------------------------------------------------------

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Angular
.angular/
dist/
tmp/
out-tsc/
bazel-out/

# TypeScript build info
*.tsbuildinfo

# Testing
/coverage
libpeerconnection.log
testem.log
/typings
karma.conf.local.js

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------

# VS Code (keep intentionally-shared settings if they exist)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo

# -----------------------------------------------------------------------------
# Operating systems
# -----------------------------------------------------------------------------

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# -----------------------------------------------------------------------------
# Environment / secrets
# -----------------------------------------------------------------------------

.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
appsettings.Development.json
appsettings.Local.json
appsettings.*.Local.json
